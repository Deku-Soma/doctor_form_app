/* Modern Theme based on HealthCorp360 Palette */

QWidget {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 14px;
    color: #1d0118;
    background-color: #f4f6f9;
}

/* --- Main Window & Containers --- */
QMainWindow, QStackedWidget {
    background-color: #f4f6f9;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* --- Typography --- */
QLabel {
    color: #163b4d; /* Deep Teal */
    font-weight: 500;
}

QLabel[heading="true"] {
    font-size: 24px;
    font-weight: bold;
    color: #163b4d;
    margin-bottom: 10px;
}

/* --- Input Fields --- */
QLineEdit, QTextEdit, QDateEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 8px;
    color: #1d0118;
    selection-background-color: #163b4d;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 2px solid #163b4d;
}

QLineEdit:hover, QTextEdit:hover, QDateEdit:hover, QComboBox:hover {
    border: 1px solid #163b4d;
}

/* --- Buttons --- */
QPushButton {
    background-color: #163b4d; /* Deep Teal */
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #685070; /* Muted Purple Accent on Hover */
}

QPushButton:pressed {
    background-color: #1d0118;
    padding-top: 11px; /* Slight press effect */
    padding-bottom: 9px;
}

QPushButton:disabled {
    background-color: #b0bec5;
    color: #f4f6f9;
}

/* --- Signature Pad Area --- */
QWidget#SignaturePad {
    background-color: #ffffff;
    border: 1px dashed #163b4d;
    border-radius: 6px;
}

/* --- Specific Overrides --- */
/* Make scrollbars slightly prettier/slimmer if possible (OS dependent, but standard Qt tweaks) */
QScrollBar:vertical {
    border: none;
    background: #f4f6f9;
    width: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #b0bec5;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
